{% extends 'base.html.twig' %}
{% block title %}Erreur serveur · GoRun{% endblock %}
{% block body %}
<div class="min-h-[60vh] flex items-center justify-center px-4">
  <div class="text-center max-w-2xl">
    
    {# Illustration #}
    <div class="mb-8">
      <div class="text-9xl mb-4">⚠️</div>
      <h1 class="text-6xl font-bold mb-2">500</h1>
    </div>
    {# Message #}
    <h2 class="text-3xl font-bold mb-4">
      Oups ! Quelque chose s'est mal passé
    </h2>
    
    <p class="text-lg text-navy/60 mb-8">
      Nos serveurs ont trébuché sur un obstacle inattendu.<br>
      Nos équipes ont été prévenues et travaillent sur le problème.
    </p>
    {# Actions #}
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="{{ path('event_index') }}" 
         class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-2xl font-semibold hover:bg-primary-light transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        Retour à l'accueil
      </a>
      <button onclick="window.location.reload()" 
              class="inline-flex items-center gap-2 bg-gray-200 text-navy px-6 py-3 rounded-2xl font-semibold hover:bg-gray-300 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        Réessayer
      </button>
    </div>
    {# Info #}
    <div class="mt-12 pt-8 border-t border-gray-200">
      <p class="text-sm text-navy/60 mb-3">
        🔧 En attendant, vous pouvez :
      </p>
      <div class="flex flex-wrap gap-3 justify-center text-sm">
        <span class="text-navy/60">• Rafraîchir la page dans quelques instants</span>
        <span class="text-navy/60">• Vider le cache de votre navigateur</span>
        <span class="text-navy/60">• Réessayer plus tard</span>
      </div>
    </div>
  </div>
</div>
{% endblock %}