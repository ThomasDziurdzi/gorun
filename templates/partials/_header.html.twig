<header class="bg-white shadow-md sticky top-0 z-20">
  <div class="max-w-6xl mx-auto flex items-center justify-between p-4">
    <div class="flex items-center space-x-2">
      {# <img src="{{ asset('logo.png') }}" alt="Logo" class="h-10 w-10" /> #}
      <a href="{{ path('app_default') }}" class="text-3xl font-bold text-primary">GoRun</a>
    </div>
    <nav class="hidden md:flex items-center space-x-6 text-lg font-semibold">
      <a href="{{ path('event_index') }}" class="text-navy hover:text-primary">Événements</a>
      {% if app.user %}
        <a href="{{ path('app_profile') }}" class="text-navy hover:text-primary">Mon profil</a>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('event_new') }}" class="text-navy hover:text-primary">Créer</a>
        {% endif %}
        <a href="{{ path('app_logout') }}" class="text-navy hover:text-primary">Déconnexion</a>
      {% else %}
        <a href="{{ path('app_register') }}" class="text-navy hover:text-primary">Inscription</a>
        <a href="{{ path('app_login') }}" class="text-navy hover:text-primary">Connexion</a>
      {% endif %}
    </nav>
    <button class="md:hidden inline-flex items-center justify-center h-10 w-10 rounded-xl border text-primary hover:bg-gray-50"
      id="rt-menu-toggle" aria-label="Ouvrir le menu" aria-controls="rt-mobile-menu" aria-expanded="false" type="button">
      <span aria-hidden="true">☰</span>
    </button>
  </div>
  <div id="rt-mobile-menu" class="md:hidden hidden border-t bg-white" aria-hidden="true">
    <nav class="max-w-6xl mx-auto py-3 px-4 grid gap-1 text-base font-semibold">
      <a href="{{ path('event_index') }}" class="px-3 py-2 rounded-xl text-navy hover:bg-gray-50 hover:text-primary">Événements</a>
      {% if app.user %}
        <a href="{{ path('app_profile') }}" class="px-3 py-2 rounded-xl text-navy hover:bg-gray-50 hover:text-primary">Mon profil</a>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('event_new') }}" class="px-3 py-2 rounded-xl text-navy hover:bg-gray-50 hover:text-primary">Créer</a>
        {% endif %}
        <a href="{{ path('app_logout') }}" class="px-3 py-2 rounded-xl text-navy hover:bg-gray-50 hover:text-primary">Déconnexion</a>
      {% else %}
        <a href="{{ path('app_register') }}" class="px-3 py-2 rounded-xl text-navy hover:bg-gray-50 hover:text-primary">Inscription</a>
        <a href="{{ path('app_login') }}" class="px-3 py-2 rounded-xl text-navy hover:bg-gray-50 hover:text-primary">Connexion</a>
      {% endif %}
    </nav>
  </div>
</header>
<script>
  (function(){
    const btn = document.getElementById('rt-menu-toggle');
    const panel = document.getElementById('rt-mobile-menu');
    if (!btn || !panel) return;
    btn.addEventListener('click', function(){
      const expanded = panel.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      panel.setAttribute('aria-hidden', expanded ? 'true' : 'false');
      btn.innerHTML = expanded ? '<span aria-hidden="true">☰</span>' : '<span aria-hidden="true">✕</span>';
    });
  })();
</script>