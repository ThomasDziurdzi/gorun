<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}GoRun{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  {% block stylesheets %}{% endblock %}
  {{ encore_entry_link_tags('app') }}
</head>
<body class="min-h-screen flex flex-col bg-gray-50 text-navy">
  {{ include('partials/_header.html.twig') }}
  <main class="flex-1 px-4 md:px-6 py-8 max-w-6xl mx-auto">
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-4 p-3 rounded-xl {{ label == 'success' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' }}">{{ message }}</div>
      {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
  </main>
  {{ include('partials/_footer.html.twig') }}
  {% block javascripts %}{% endblock %}
  {{ encore_entry_script_tags('app') }}
</body>
</html>